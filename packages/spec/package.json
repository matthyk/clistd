{
  "name": "@clistd/spec",
  "version": "0.1.0",
  "description": "Public types and JSON Schema for clistd CLI specifications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthyk/clistd.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "borp --pattern 'test/**/*.test.ts'",
    "test:coverage": "borp --coverage --pattern 'test/**/*.test.ts'",
    "typecheck": "tsc --project tsconfig.json --pretty false"
  }
}
