{
  "name": "@clistd/cli",
  "version": "0.0.0",
  "description": "oclif command-line interface for validating and linting clistd documents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthyk/clistd.git"
  },
  "bin": {
    "clistd": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./configuration.schema.json": "./dist/configuration.schema.json"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json && npm run copy:configuration-schema",
    "copy:configuration-schema": "node ./scripts/copy-configuration-schema.mjs",
    "test": "borp --pattern 'test/**/*.test.ts'",
    "test:coverage": "borp --coverage --pattern 'test/**/*.test.ts'",
    "typecheck": "tsc --project tsconfig.json --pretty false"
  },
  "dependencies": {
    "@clistd/adapter": "^0.0.0",
    "@clistd/adapter-commander": "^0.0.0",
    "@clistd/adapter-oclif": "^0.0.0",
    "@clistd/clig-rules": "^0.0.0",
    "@clistd/core": "^0.0.0",
    "@clistd/linter": "^0.0.0",
    "@clistd/recommend-rules": "^0.0.0",
    "@oclif/core": "^4.5.3",
    "@oclif/plugin-autocomplete": "^3.3.0",
    "@oclif/plugin-not-found": "^3.3.0",
    "js-yaml": "^5.0.1"
  },
  "devDependencies": {
    "@oclif/test": "^4.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "commander": "^15.0.0",
    "ts-node": "^10.9.2"
  },
  "oclif": {
    "bin": "clistd",
    "commands": "./dist/commands",
    "dirname": "clistd",
    "plugins": [
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-not-found"
    ],
    "topicSeparator": " "
  }
}
