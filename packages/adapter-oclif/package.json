{
  "name": "@clistd/adapter-oclif",
  "version": "0.1.0",
  "description": "Built-in Oclif project adapter for clistd.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthyk/clistd.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "borp --pattern 'test/**/*.test.ts'",
    "test:coverage": "borp --coverage --pattern 'test/**/*.test.ts'",
    "typecheck": "tsc --project tsconfig.json --pretty false"
  },
  "dependencies": {
    "@clistd/adapter": "^0.1.0",
    "@oclif/core": "^4.5.3"
  },
  "devDependencies": {
    "@clistd/core": "^0.1.0",
    "@types/node": "^22.0.0"
  }
}
